    'E': [],
    'F': []
}

visited = []

def dfs(node):
    if node not in visited:
        print(node, end=" ")
        visited.append(node)

        for neighbour in graph[node]:
            dfs(neighbour)

print("DFS Traversal:")
dfs('A')


graph = [
    [0, 2, 3, 0],
    [2, 0, 1, 4],
    [3, 1, 0, 5],
    [0, 4, 5, 0]
]

n = len(graph)
visited = [False] * n
visited[0] = True
cost = 0

for _ in range(n - 1):
    minimum = float('inf')
    x = -1
    y = -1

    for i in range(n):
        if visited[i]:
            for j in range(n):
                if graph[i][j] != 0 and not visited[j]:
                    if graph[i][j] < minimum:
                        minimum = graph[i][j]
                        x = i
                        y = j

    print(x, "-", y, ":", minimum)
    cost += minimum
    visited[y] = True

print("Minimum cost:", cost)

print("BFS Traversal:", bfs(adj))
